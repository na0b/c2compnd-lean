import C2CompND.Preamble
/-- The family of vector fields on `R^n` generated by the frame `sigma` under Lie brackets:
the paper's `Lie (X_1, ..., X_m)`, for `X_i = sigma^i(x) . grad`. -/
inductive HorFamily {n m : ℕ}
    (σ : Fin m → EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) :
    (EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) → Prop where
  | base (i : Fin m) : HorFamily σ (σ i)
  | bracket {V W : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)} :
      HorFamily σ V → HorFamily σ W → HorFamily σ (VectorField.lieBracket ℝ V W)
